---

<BaseLayout
  title="Sobre mí — Alberto Adrián Mártir González"
  description="Trayectoria profesional, formación, logros, eventos científicos y proyectos de innovación de Alberto Adrián Mártir González."
>
  <Nav />

  <!-- ============ HERO SOBRE MÍ ============ -->
  <section class="about-hero">
    <div class="container about-hero-inner">
      <span class="eyebrow">Sobre mí</span>
      <h1 class="display about-title">
        Trayectoria<span class="dot">.</span>
      </h1>
      <p class="about-titular">{perfil.titular}</p>
      <p class="about-resumen">{perfil.resumen}</p>
      <div class="about-actions">
        <a href={perfil.cv} class="btn btn-primary">
          Descargar CV completo
          <span aria-hidden="true">→</span>
        </a>
        <a href="/contacto" class="btn btn-ghost">Contacto</a>
      </div>
    </div>
  </section>

  <!-- ============ TIMELINE ============ -->
  <section class="timeline-section">
    <div class="container">
      <header class="timeline-head">
        <h2 class="display timeline-title">
          Línea de tiempo<span class="dot">.</span>
        </h2>
        <p class="timeline-sub">
          Formación y experiencia en orden cronológico.
        </p>
      </header>

      <div class="filters" role="tablist" aria-label="Filtrar línea de tiempo">
        <button class="filter active" data-filter="todo" role="tab" aria-selected="true">Todo</button>
        <button class="filter" data-filter="experiencia" role="tab" aria-selected="false">Experiencia</button>
        <button class="filter" data-filter="formacion" role="tab" aria-selected="false">Formación</button>
      </div>

      <ol class="timeline" id="timeline">
        {timeline.map((item) => (
          <li class="tl-item" data-tipo={item.tipo}>
            <div class="tl-marker">
              <span class="tl-dot"></span>
            </div>
            <article class="tl-card">
              <header class="tl-card-head">
                <span class={`tl-badge tl-badge-${item.tipo}`}>
                  {item.tipo === 'experiencia' ? 'Experiencia' : 'Formación'}
                </span>
                <span class="tl-fecha">{item.fecha}</span>
              </header>
              <h3 class="tl-role display">{item.titulo}</h3>
              <p class="tl-inst">
                <strong>{item.institucion}</strong>
                <span class="tl-lugar"> · {item.lugar}</span>
              </p>
              <p class="tl-desc">{item.descripcion}</p>
              <ul class="tl-skills">
                {item.skills.map((s) => <li>{s}</li>)}
              </ul>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ LOGROS ============ -->
  <section class="logros-section">
    <div class="container">
      <header class="timeline-head">
        <h2 class="display timeline-title">
          Logros destacados<span class="dot">.</span>
        </h2>
        <p class="timeline-sub">
          Reconocimientos académicos y profesionales.
        </p>
      </header>
      <div class="logros-grid">
        {logros.map((l) => (
          <article class="logro-card">
            <span class="logro-year">{l.year}</span>
            <h3 class="logro-title display">{l.titulo}</h3>
            <p class="logro-detail">{l.detalle}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EVENTOS CIENTÍFICOS ============ -->
  <section class="eventos-section">
    <div class="container">
      <header class="timeline-head">
        <h2 class="display timeline-title">
          Eventos y jornadas científicas<span class="dot">.</span>
        </h2>
        <p class="timeline-sub">
          Congresos, simposios y jornadas en los que he participado como ponente o asistente.
        </p>
      </header>
      <ul class="eventos-grid">
        {eventos.map((e) => (
          <li class="evento-card">
            <span class="evento-year">{e.year}</span>
            <h3 class="evento-nombre">{e.nombre}</h3>
            <p class="evento-contexto">{e.contexto}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ PROYECTOS I+D ============ -->
  <section class="proyectos-section">
    <div class="container">
      <header class="timeline-head">
        <h2 class="display timeline-title">
          Proyectos de innovación y desarrollo<span class="dot">.</span>
        </h2>
        <p class="timeline-sub">
          Proyectos activos y recientes en los que participo o he participado.
        </p>
      </header>
      <div class="proyectos-grid">
        {proyectos.map((p) => (
          <article class="proyecto-card">
            <header class="proyecto-head">
              <span class="proyecto-estado">{p.estado}</span>
              <span class="proyecto-periodo">{p.periodo}</span>
            </header>
            <h3 class="proyecto-nombre display">{p.nombre}</h3>
            <p class="proyecto-inst">{p.institucion}</p>
            <p class="proyecto-desc">{p.descripcion}</p>
            <ul class="proyecto-tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DOCENCIA ============ -->
  <section class="docencia-section">
    <div class="container">
      <header class="timeline-head">
        <h2 class="display timeline-title">
          Docencia y formación continua<span class="dot">.</span>
        </h2>
      </header>
      <div class="docencia-grid">
        <div class="docencia-col">
          <h3 class="docencia-sub">Asignaturas impartidas</h3>
          <ul class="docencia-list">
            {docencia.impartidos.map((d) => <li>{d}</li>)}
          </ul>
        </div>
        <div class="docencia-col">
          <h3 class="docencia-sub">Cursos y herramientas recibidas</h3>
          <ul class="docencia-list">
            {docencia.recibidos.map((d) => <li>{d}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
    <!-- ============ HABILIDADES ============ -->
  <section class="habilidades-section">
    <div class="container">
      <header class="timeline-head">
        <h2 class="display timeline-title">
          Competencias y habilidades<span class="dot">.</span>
        </h2>
        <p class="timeline-sub">
          Lo que aporto más allá del conocimiento técnico.
        </p>
      </header>

      <div class="habilidades-grid">
        <div class="hab-col">
          <h3 class="hab-col-title">Soft skills</h3>
          <ul class="soft-list">
            {habilidades.soft.map((s) => (
              <li class="soft-item">
                <span class="soft-marker" aria-hidden="true"></span>
                <div>
                  <strong>{s.nombre}</strong>
                  <p>{s.detalle}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="hab-col">
          <h3 class="hab-col-title">Competencias técnicas</h3>
          <div class="tecnicas-list">
            {habilidades.tecnicas.map((t) => (
              <div class="tecnica-grupo">
                <span class="tecnica-area">{t.area}</span>
                <ul class="tecnica-items">
                  {t.items.map((i) => <li>{i}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Idiomas -->
      <div class="idiomas-block">
        <h3 class="hab-col-title">Idiomas</h3>
        <ul class="idiomas-list">
          {idiomas.map((i) => (
            <li class="idioma-item">
              <div class="idioma-head">
                <span class="idioma-nombre">{i.nombre}</span>
                <span class="idioma-nivel">{i.nivel} · {i.etiqueta}</span>
              </div>
              <div class="idioma-bar" role="img" aria-label={`${i.nombre}: ${i.nivel}`}>
                <span class="idioma-fill" style={`width: ${i.valor}%`}></span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/timeline-filter.js';
</script>

<style>
  /* ---------- HERO SOBRE MÍ ---------- */
  .about-hero {
    padding: var(--space-8) 0 var(--space-6);
  }
  .about-hero-inner { max-width: 820px; }
  .about-title {
    font-size: clamp(3rem, 7vw, 5rem);
    margin: var(--space-3) 0 var(--space-4);
    color: var(--surface-dark);
  }
  .about-titular {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 var(--space-4);
    letter-spacing: 0.01em;
  }
  .about-resumen {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 720px;
    margin: 0 0 var(--space-5);
  }
  .about-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* ---------- TIMELINE ---------- */
  .timeline-section {
    padding: var(--space-7) 0;
    background: linear-gradient(180deg, transparent 0%, rgba(229, 226, 220, 0.35) 50%, transparent 100%);
  }
  .timeline-head { max-width: 620px; margin-bottom: var(--space-5); }
  .timeline-title {
