---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import Icon from '../../components/Icon.astro';
import { perfil, asignaturas } from '../../data/profesor';

const navLinks = [
  { href: '/profesor', label: 'Portada' },
  { href: '/profesor/asignaturas', label: 'Asignaturas' },
  { href: '/profesor/trayectoria', label: 'Trayectoria' },
  { href: '/profesor/formacion', label: 'Formación' },
];

const porInstitucion = {
  'FCM "Salvador Allende"': asignaturas.filter((a) => a.institucion === 'FCM "Salvador Allende"'),
  'DISAIC': asignaturas.filter((a) => a.institucion === 'DISAIC'),
};
---

<MicrositeLayout
  nombre="Profesor"
  acento="#2D5A4A"
  acentoSuave="#C68A3E"
  navLinks={navLinks}
  title="Asignaturas impartidas — Alberto M. · Docencia"
  description="Asignaturas impartidas en la Universidad de Ciencias Médicas Salvador Allende y en DISAIC."
>
  <section class="page-head">
    <div class="container">
      <span class="head-eyebrow">Sección 01</span>
      <h1 class="display head-title">
        Asignaturas<span class="pizarra-dot">.</span>
      </h1>
      <p class="head-desc">
        Materias impartidas en pregrado y cursos de formación técnica. Cada
        asignatura incluye su institución, icono representativo y enfoque
        principal.
      </p>
    </div>
  </section>

  <section class="asignaturas-section">
    <div class="container">
      {Object.entries(porInstitucion).map(([institucion, items]) => (
        <div class="institucion-bloque">
          <header class="institucion-head">
            <h2 class="display institucion-title">{institucion}</h2>
            <span class="institucion-count">{items.length} asignaturas</span>
          </header>

          <ul class="asignaturas-grid">
            {items.map((a) => (
              <li class="asignatura-card">
                <div class="asignatura-icon">
                  <Icon name={a.icono} size={26} stroke={1.6} />
                </div>
                <div class="asignatura-body">
                  <h3 class="asignatura-name display">{a.nombre}</h3>
                  <p class="asignatura-desc">{a.descripcion}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Ver CV" />
</MicrositeLayout>

<style>
  .page-head {
    padding: var(--space-7) 0 var(--space-5);
  }
  .head-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-3);
  }
  .head-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 var(--space-3);
    color: var(--surface-dark);
  }
  .pizarra-dot { color: var(--micro-acento-suave); }
  .head-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0;
  }

  .asignaturas-section {
    padding: var(--space-5) 0 var(--space-8);
  }
  .institucion-bloque {
    margin-bottom: var(--space-7);
  }
  .institucion-bloque:last-child { margin-bottom: 0; }

  .institucion-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--micro-acento);
  }
  .institucion-title {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0;
    color: var(--surface-dark);
  }
  .institucion-count {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--micro-acento);
    background: rgba(45, 90, 74, 0.08);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }

  .asignaturas-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-3);
  }
  .asignatura-card {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .asignatura-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--micro-acento-suave);
  }
  .asignatura-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(45, 90, 74, 0.08);
    color: var(--micro-acento);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }
  .asignatura-body {
    min-width: 0;
  }
  .asignatura-name {
    font-size: 1.05rem;
    margin: 0 0 4px;
    color: var(--surface-dark);
    line-height: 1.25;
  }
  .asignatura-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .asignaturas-grid { grid-template-columns: 1fr; }
    .institucion-head { flex-direction: column; align-items: flex-start; gap: 4px; }
  }
</style>