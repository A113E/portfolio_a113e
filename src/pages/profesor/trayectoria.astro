---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import { perfil, trayectoria, posgrado, festivales } from '../../data/profesor';

const navLinks = [
  { href: '/profesor', label: 'Portada' },
  { href: '/profesor/asignaturas', label: 'Asignaturas' },
  { href: '/profesor/trayectoria', label: 'Trayectoria' },
  { href: '/profesor/formacion', label: 'Formación' },
];
---

<MicrositeLayout
  nombre="Profesor"
  acento="#2D5A4A"
  acentoSuave="#C68A3E"
  navLinks={navLinks}
  title="Trayectoria docente — Alberto M."
  description="Experiencia docente en la Universidad Salvador Allende y DISAIC, posgrado de Alfabetización Informacional y festivales de clases."
>
  <section class="page-head">
    <div class="container">
      <span class="head-eyebrow">Sección 02</span>
      <h1 class="display head-title">
        Trayectoria<span class="pizarra-dot">.</span>
      </h1>
      <p class="head-desc">
        Experiencia docente en instituciones académicas y empresariales,
        posgrado y participación en festivales de clases.
      </p>
    </div>
  </section>

  <!-- Fichas de docencia -->
  <section class="fichas-section">
    <div class="container">
      <ol class="fichas">
        {trayectoria.map((t) => (
          <li class="ficha-item">
            <div class="ficha-lomo" aria-hidden="true">
              <span class="lomo-numeral">{t.numeral}</span>
              <span class="lomo-line"></span>
            </div>
            <article class="ficha-card">
              <header class="ficha-head">
                <div class="ficha-logo">
                  <img src={t.logo} alt={`Logo de ${t.institucion}`} />
                </div>
                <div class="ficha-head-info">
                  <h2 class="ficha-cargo display">{t.cargo}</h2>
                  <p class="ficha-institucion">{t.institucion} · {t.ubicacion}</p>
                  <span class="ficha-periodo">{t.periodo}</span>
                </div>
              </header>

              <div class="ficha-block">
                <h3 class="block-title">Funciones docentes</h3>
                <ol class="funciones">
                  {t.funciones.map((f) => <li>{f}</li>)}
                </ol>
              </div>

              <div class="ficha-block">
                <h3 class="block-title block-title-accent">Logros</h3>
                <ul class="logros">
                  {t.logros.map((l) => <li>{l}</li>)}
                </ul>
              </div>

              <div class="ficha-block">
                <h3 class="block-title">Herramientas</h3>
                <ul class="herramientas">
                  {t.herramientas.map((h) => <li>{h}</li>)}
                </ul>
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Posgrado -->
  <section class="posgrado-section">
    <div class="container">
      <header class="block-head">
        <span class="block-eyebrow">Posgrado</span>
        <h2 class="display block-title">
          Alfabetización Informacional y Búsqueda Bibliográfica<span class="pizarra-dot">.</span>
        </h2>
      </header>

      <article class="posgrado-card">
        <div class="posgrado-meta">
          <span class="posgrado-rol">{posgrado.rol}</span>
          <span class="posgrado-periodo">{posgrado.periodo}</span>
        </div>
        <h3 class="posgrado-inst">{posgrado.institucion}</h3>
        <p class="posgrado-proyecto">
          Vinculado al <strong>{posgrado.proyecto}</strong>
        </p>
        <p class="posgrado-desc">{posgrado.descripcion}</p>
        <ul class="posgrado-contenidos">
          {posgrado.contenidos.map((c) => <li>{c}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <!-- Festivales -->
  <section class="festivales-section">
    <div class="container">
      <header class="block-head">
        <span class="block-eyebrow">Festivales de clases</span>
        <h2 class="display block-title">
          Participación institucional<span class="pizarra-dot">.</span>
        </h2>
        <p class="block-desc">
          Participación en el Festival de Clases de la Universidad "Salvador Allende" en sus ediciones 2022, 2023, 2024 y 2025.
        </p>
      </header>
      <ul class="festivales-grid">
        {festivales.map((f) => (
          <li class="festival-card">
            <span class="festival-year">{f.year}</span>
            <span class="festival-nombre">{f.nombre}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Descargar CV" />
</MicrositeLayout>

<style>
  .page-head { padding: var(--space-7) 0 var(--space-5); }
  .head-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-3);
  }
  .head-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 var(--space-3);
    color: var(--surface-dark);
  }
  .pizarra-dot { color: var(--micro-acento-suave); }
  .head-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0;
  }

  .fichas-section { padding: var(--space-5) 0 var(--space-7); }
  .fichas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .ficha-item {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: var(--space-5);
  }
  .ficha-lomo {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-4);
  }
  .lomo-numeral {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-3);
  }
  .lomo-line {
    flex-grow: 1;
    width: 2px;
    background: linear-gradient(180deg, var(--micro-acento), transparent);
    opacity: 0.4;
    border-radius: 2px;
  }
  .ficha-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .ficha-head {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--border);
  }
  .ficha-logo {
    width: 84px;
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 10px;
  }
  .ficha-logo img { width: 100%; height: 100%; object-fit: contain; }
  .ficha-cargo {
    font-size: 1.4rem;
    margin: 0 0 4px;
    color: var(--surface-dark);
  }
  .ficha-institucion {
    font-size: 0.95rem;
    color: var(--micro-acento);
    font-weight: 600;
    margin: 0 0 4px;
  }
  .ficha-periodo {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .ficha-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .block-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--micro-acento);
    margin: 0;
  }
  .block-title-accent { color: var(--micro-acento-suave); }
  .funciones {
    list-style: none;
    counter-reset: fn;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .funciones li {
    counter-increment: fn;
    position: relative;
    padding-left: 40px;
    font-size: 0.96rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .funciones li::before {
    content: counter(fn, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 2px;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--micro-acento-suave);
    background: rgba(198, 138, 62, 0.1);
    padding: 2px 7px;
    border-radius: 4px;
  }
  .logros {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .logros li {
    display: flex;
    gap: var(--space-2);
    font-size: 0.96rem;
    color: var(--surface-dark);
    line-height: 1.55;
  }
  .logros li::before {
    content: '▸';
    color: var(--micro-acento-suave);
    font-weight: 700;
    flex-shrink: 0;
  }
  .herramientas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .herramientas li {
    font-size: 0.82rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: rgba(45, 90, 74, 0.06);
    color: var(--micro-acento);
    border: 1px solid rgba(45, 90, 74, 0.12);
  }

  .posgrado-section {
    padding: var(--space-7) 0;
    background: rgba(45, 90, 74, 0.03);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .block-head { max-width: 720px; margin-bottom: var(--space-5); }
  .block-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-2);
  }
  .block-title {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    margin: 0 0 var(--space-2);
    color: var(--surface-dark);
  }
  .block-desc { color: var(--text-muted); margin: 0; }

  .posgrado-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 4px solid var(--micro-acento);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .posgrado-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-3);
  }
  .posgrado-rol {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 12px;
    background: var(--micro-acento);
    color: var(--text-inverse);
    border-radius: var(--radius-pill);
  }
  .posgrado-periodo {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .posgrado-inst {
    font-size: 1.2rem;
    margin: 0 0 4px;
    color: var(--surface-dark);
  }
  .posgrado-proyecto {
    font-size: 0.92rem;
    color: var(--micro-acento);
    margin: 0 0 var(--space-3);
  }
  .posgrado-proyecto strong { color: var(--micro-acento-suave); }
  .posgrado-desc {
    font-size: 0.96rem;
    color: var(--text-muted);
    margin: 0 0 var(--space-4);
    line-height: 1.6;
  }
  .posgrado-contenidos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 8px;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--border);
  }
  .posgrado-contenidos li {
    font-size: 0.9rem;
    color: var(--text-muted);
    padding-left: 18px;
    position: relative;
  }
  .posgrado-contenidos li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--micro-acento-suave);
    font-weight: 700;
  }

  .festivales-section {
    padding: var(--space-7) 0 var(--space-8);
  }
  .festivales-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .festival-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .festival-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .festival-year {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--micro-acento);
    line-height: 1;
  }
  .festival-nombre {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .ficha-item { grid-template-columns: 1fr; gap: var(--space-3); }
    .ficha-lomo { flex-direction: row; padding-top: 0; gap: var(--space-3); }
    .lomo-numeral { margin-bottom: 0; }
    .lomo-line { width: auto; height: 2px; flex-grow: 1; background: linear-gradient(90deg, var(--micro-acento), transparent); }
    .ficha-card { padding: var(--space-4); }
    .festivales-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>