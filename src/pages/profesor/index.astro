---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import { perfil, asignaturas, trayectoria } from '../../data/profesor';

const navLinks = [
  { href: '/profesor', label: 'Portada' },
  { href: '/profesor/asignaturas', label: 'Asignaturas' },
  { href: '/profesor/trayectoria', label: 'Trayectoria' },
  { href: '/profesor/formacion', label: 'Formación' },
];

const subsecciones = [
  {
    numero: '01',
    href: '/profesor/asignaturas',
    titulo: 'Asignaturas',
    descripcion: 'Materias impartidas en pregrado y cursos de formación técnica.',
    icono: 'book',
  },
  {
    numero: '02',
    href: '/profesor/trayectoria',
    titulo: 'Trayectoria',
    descripcion: 'Experiencia docente, posgrado y festivales de clases.',
    icono: 'compass',
  },
  {
    numero: '03',
    href: '/profesor/formacion',
    titulo: 'Formación',
    descripcion: 'Títulos y certificaciones que respaldan la práctica docente.',
    icono: 'award',
  },
];
---

<MicrositeLayout
  nombre="Profesor"
  acento="#2D5A4A"
  acentoSuave="#C68A3E"
  navLinks={navLinks}
  title="Docencia — Alberto Adrián Mártir González"
  description="Profesor universitario, docencia en Ciencias de la Información, mentoría académica y formación técnica."
>
  <!-- ============ PIZARRA HERO ============ -->
  <section class="pizarra">
    <div class="container pizarra-inner">
      <div class="pizarra-board">
        <span class="tiza-kicker">Docencia</span>
        <h1 class="tiza-nombre">
          Alberto Adrián Mártir González<span class="tiza-dot">.</span>
        </h1>
        <p class="tiza-titular">{perfil.titular}</p>
        <p class="tiza-resumen">{perfil.resumen}</p>

        <div class="tiza-meta">
          <span><strong>{asignaturas.length}</strong> asignaturas impartidas</span>
          <span><strong>{trayectoria.length}</strong> instituciones</span>
          <span><strong>4</strong> cursos académicos</span>
        </div>

        <div class="tiza-actions">
          <a href="/profesor/trayectoria" class="btn-pizarra">Ver trayectoria →</a>
          <a href={perfil.cv} class="btn-pizarra-ghost">Ver CV ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SUBSECCIONES ============ -->
  <section class="subsecciones">
    <div class="container">
      <header class="sub-head">
        <span class="sub-eyebrow">Explora</span>
        <h2 class="display sub-title">
          Tres miradas a la docencia<span class="pizarra-dot">.</span>
        </h2>
      </header>

      <div class="tabs">
        {subsecciones.map((s) => (
          <a href={s.href} class="tab">
            <span class="tab-num">{s.numero}</span>
            <h3 class="tab-title display">{s.titulo}</h3>
            <p class="tab-desc">{s.descripcion}</p>
            <span class="tab-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Descargar CV" />
</MicrositeLayout>

<style>
  .pizarra {
    padding: var(--space-7) 0 var(--space-6);
    background: linear-gradient(180deg, #1E3A30 0%, #2D5A4A 100%);
    position: relative;
    overflow: hidden;
  }
  .pizarra::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.04) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(198,138,62,0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .pizarra-inner { position: relative; z-index: 1; }
  .pizarra-board {
    max-width: 780px;
  }
  .tiza-kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-4);
  }
  .tiza-nombre {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 500;
    margin: 0 0 var(--space-3);
    color: #F4EDE0;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .tiza-dot { color: var(--micro-acento-suave); }
  .tiza-titular {
    font-size: 1.05rem;
    color: rgba(244, 237, 224, 0.85);
    margin: 0 0 var(--space-4);
    font-weight: 500;
  }
  .tiza-resumen {
    font-size: 1.02rem;
    color: rgba(244, 237, 224, 0.7);
    margin: 0 0 var(--space-5);
    max-width: 640px;
    line-height: 1.6;
  }
  .tiza-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding: var(--space-4) 0;
    border-top: 1px solid rgba(244, 237, 224, 0.15);
    border-bottom: 1px solid rgba(244, 237, 224, 0.15);
    margin-bottom: var(--space-5);
  }
  .tiza-meta span {
    font-size: 0.88rem;
    color: rgba(244, 237, 224, 0.7);
  }
  .tiza-meta strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--micro-acento-suave);
    margin-right: 6px;
    vertical-align: middle;
  }
  .tiza-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .btn-pizarra {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    background: var(--micro-acento-suave);
    color: #1E3A30;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .btn-pizarra:hover {
    background: #D9A05C;
    transform: translateY(-2px);
  }
  .btn-pizarra-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 22px;
    background: transparent;
    color: #F4EDE0;
    border: 1px solid rgba(244, 237, 224, 0.3);
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .btn-pizarra-ghost:hover {
    border-color: #F4EDE0;
    transform: translateY(-2px);
  }

  .subsecciones {
    padding: var(--space-7) 0 var(--space-8);
  }
  .sub-head {
    max-width: 620px;
    margin-bottom: var(--space-5);
  }
  .sub-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-2);
  }
  .sub-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0;
    color: var(--surface-dark);
  }
  .pizarra-dot { color: var(--micro-acento-suave); }

  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .tab {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .tab::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: var(--micro-acento);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .tab:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .tab:hover::before { transform: scaleX(1); }
  .tab-num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--micro-acento-suave);
  }
  .tab-title {
    font-size: 1.5rem;
    margin: 0;
    color: var(--surface-dark);
  }
  .tab-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    margin: 0;
    flex-grow: 1;
  }
  .tab-arrow {
    font-size: 1.2rem;
    color: var(--text-muted);
    transition: transform var(--transition-base), color var(--transition-base);
  }
  .tab:hover .tab-arrow {
    transform: translateX(6px);
    color: var(--micro-acento);
  }

  @media (max-width: 900px) {
    .tabs { grid-template-columns: 1fr; }
    .tiza-meta { gap: var(--space-4); }
  }
</style>