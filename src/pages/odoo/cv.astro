---
import CVLayout from '../../layouts/CVLayout.astro';
import Icon from '../../components/Icon.astro';
import {
  perfil,
  proyectos,
  trayectoria,
  stack,
  formacion,
  certificaciones,
  softSkills,
  idiomas,
} from '../../data/odoo';

const contacto = [
  { icono: 'email', valor: perfil.email },
  { icono: 'telefono', valor: perfil.telefono },
  { icono: 'ubicacion', valor: perfil.ubicacion },
  { icono: 'github', valor: perfil.github },
  { icono: 'linkedin', valor: perfil.linkedin },
];

const stackPlano = stack.categorias.map((c) => ({
  categoria: c.titulo,
  items: c.items.map((i) => `${i.nombre} (${i.nivel})`),
}));

const totalModulos = proyectos.reduce((acc, p) => {
  return acc + p.aportes.flatMap((a) => a.items.filter((i) => i.includes('—'))).length;
}, 0);
---

<CVLayout title="CV — Alberto Adrián Mártir González · Desarrollo Odoo">
  <!-- CABECERA -->
  <header class="cv-header">
    <div class="cv-photo">
      <img src="/img/albe.png" alt="Foto de perfil de Alberto M." />
    </div>
    <div class="cv-header-main">
      <h1 class="cv-name">{perfil.nombre}</h1>
      <p class="cv-title">{perfil.titular}</p>
    </div>
    <ul class="cv-contact">
      {contacto.map((c) => (
        <li>
          <Icon name={c.icono} size={14} stroke={1.8} />
          <span>{c.valor}</span>
        </li>
      ))}
    </ul>
  </header>

  <!-- PERFIL -->
  <section class="cv-section">
    <h2 class="cv-section-title">Perfil profesional</h2>
    <p class="cv-summary">{perfil.resumen}</p>
  </section>

  <!-- PROYECTOS DESTACADOS -->
  <section class="cv-section">
    <h2 class="cv-section-title">Proyectos destacados</h2>
    {proyectos.map((p) => (
      <article class="cv-job">
        <header class="cv-job-head">
          <div>
            <h3 class="cv-job-cargo">{p.nombre}</h3>
            <p class="cv-job-inst">{p.tagline} · {p.cliente}</p>
          </div>
          <span class="cv-job-periodo">{p.periodo}</span>
        </header>
        <p class="cv-job-rol"><strong>Rol:</strong> {p.rol} · <strong>Stack:</strong> {p.versiones.join(', ')}</p>
        {p.aportes.map((a) => (
          <div class="cv-aporte">
            <h4 class="cv-aporte-titulo">{a.titulo}</h4>
            <ul class="cv-job-funciones">
              {a.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </article>
    ))}
  </section>

  <!-- EXPERIENCIA -->
  <section class="cv-section">
    <h2 class="cv-section-title">Experiencia profesional</h2>
    {trayectoria.map((t) => (
      <article class="cv-job">
        <header class="cv-job-head">
          <div>
            <h3 class="cv-job-cargo">{t.cargo}</h3>
            <p class="cv-job-inst">{t.institucion} · {t.ubicacion}</p>
          </div>
          <span class="cv-job-periodo">{t.periodo}</span>
        </header>
        <ul class="cv-job-funciones">
          {t.funciones.map((f) => <li>{f}</li>)}
        </ul>
        {t.logros.length > 0 && (
          <ul class="cv-job-logros">
            {t.logros.map((l) => <li>{l}</li>)}
          </ul>
        )}
      </article>
    ))}
  </section>

  <!-- STACK -->
  <section class="cv-section">
    <h2 class="cv-section-title">Stack técnico</h2>
    <div class="cv-skills-grid">
      {stackPlano.map((s) => (
        <div class="cv-skill-group">
          <h3 class="cv-skill-cat">{s.categoria}</h3>
          <p class="cv-skill-list">{s.items.join(' · ')}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FORMACIÓN -->
  <section class="cv-section">
    <h2 class="cv-section-title">Formación</h2>
    {formacion.map((f) => (
      <article class="cv-edu">
        <header class="cv-edu-head">
          <div>
            <h3 class="cv-edu-titulo">{f.titulo}</h3>
            <p class="cv-edu-inst">{f.institucion}</p>
          </div>
          <span class="cv-edu-periodo">{f.periodo}</span>
        </header>
        {f.destacado && <p class="cv-edu-destacado">{f.destacado}</p>}
      </article>
    ))}
    <div class="cv-cert-block">
      <h3 class="cv-subtitle">Certificaciones</h3>
      <ul class="cv-cert-list">
        {certificaciones.map((c) => (
          <li>
            <strong>{c.titulo}</strong> — {c.institucion} ({c.periodo})
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- IDIOMAS Y SOFT SKILLS -->
  <section class="cv-section cv-section-final">
    <div class="cv-two-col">
      <div>
        <h2 class="cv-section-title">Idiomas</h2>
        <ul class="cv-idiomas">
          {idiomas.map((i) => (
            <li><strong>{i.nombre}</strong> — {i.nivel} ({i.etiqueta})</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="cv-section-title">Soft skills</h2>
        <p class="cv-soft">{softSkills.map((s) => s.nombre).join(' · ')}</p>
      </div>
    </div>
  </section>
</CVLayout>