---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import { perfil, proyectos } from '../../data/investigador';

const navLinks = [
  { href: '/investigador', label: 'Portada' },
  { href: '/investigador/trayectoria', label: 'Trayectoria' },
  { href: '/investigador/publicaciones', label: 'Publicaciones' },
  { href: '/investigador/proyectos', label: 'Proyectos' },
  { href: '/investigador/formacion', label: 'Formación' },
];
---

<MicrositeLayout
  nombre="Investigador"
  acento="#6B2737"
  acentoSuave="#B8860B"
  navLinks={navLinks}
  title="Proyectos I+D — Alberto M. · Investigación"
  description="Proyectos de investigación e innovación en salud, educación e informática."
>
  <section class="page-head">
    <div class="container">
      <span class="head-eyebrow">Sección 03</span>
      <h1 class="display head-title">
        Proyectos<span class="hero-dot">.</span>
      </h1>
      <p class="head-desc">
        Proyectos de I+D en los que he participado, con el rol desempeñado en
        cada uno y su periodo de ejecución.
      </p>
    </div>
  </section>

  <section class="proyectos-section">
    <div class="container">
      <div class="proyectos-grid">
        {proyectos.map((p) => (
          <article class="proyecto-card">
            <header class="proyecto-head">
              <span class="proyecto-rol">{p.rol}</span>
              <span class="proyecto-periodo">{p.periodo}</span>
            </header>
            <h3 class="proyecto-nombre display">{p.nombre}</h3>
            <p class="proyecto-inst">{p.institucion}</p>
            <p class="proyecto-desc">{p.descripcion}</p>
            <ul class="proyecto-tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Ver CV" />
</MicrositeLayout>

<style>
  .page-head { padding: var(--space-7) 0 var(--space-5); }
  .head-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-3);
  }
  .head-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 var(--space-3);
    color: var(--surface-dark);
  }
  .hero-dot { color: var(--micro-acento-suave); }
  .head-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0;
  }

  .proyectos-section { padding: var(--space-5) 0 var(--space-8); }
  .proyectos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }
  .proyecto-card {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .proyecto-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--micro-acento);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .proyecto-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .proyecto-card:hover::before { transform: scaleX(1); }
  .proyecto-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .proyecto-rol {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--micro-acento);
    color: var(--text-inverse);
  }
  .proyecto-periodo {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .proyecto-nombre {
    font-size: 1.2rem;
    margin: var(--space-1) 0 0;
    color: var(--surface-dark);
    line-height: 1.3;
  }
  .proyecto-inst {
    font-size: 0.88rem;
    color: var(--micro-acento);
    font-weight: 600;
    margin: 0;
  }
  .proyecto-desc {
    font-size: 0.94rem;
    color: var(--text-muted);
    margin: var(--space-2) 0 var(--space-3);
    flex-grow: 1;
    line-height: 1.55;
  }
  .proyecto-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .proyecto-tags li {
    font-size: 0.76rem;
    font-weight: 500;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgba(107, 39, 55, 0.06);
    color: var(--micro-acento);
    border: 1px solid rgba(107, 39, 55, 0.12);
  }

  @media (max-width: 900px) {
    .proyectos-grid { grid-template-columns: 1fr; }
  }
</style>