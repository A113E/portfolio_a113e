---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import Icon from '../../components/Icon.astro';
import { perfil, publicaciones } from '../../data/investigador';

const navLinks = [
  { href: '/investigador', label: 'Portada' },
  { href: '/investigador/trayectoria', label: 'Trayectoria' },
  { href: '/investigador/publicaciones', label: 'Publicaciones' },
  { href: '/investigador/proyectos', label: 'Proyectos' },
  { href: '/investigador/formacion', label: 'Formación' },
];

// Agrupar por año descendente
const porYear = publicaciones.reduce((acc, p) => {
  if (!acc[p.year]) acc[p.year] = [];
  acc[p.year].push(p);
  return acc;
}, {} as Record<string, typeof publicaciones>);

const years = Object.keys(porYear).sort((a, b) => Number(b) - Number(a));
---

<MicrositeLayout
  nombre="Investigador"
  acento="#6B2737"
  acentoSuave="#B8860B"
  navLinks={navLinks}
  title="Publicaciones — Alberto M. · Investigación"
  description="Publicaciones científicas en revistas cubanas e internacionales y ponencias en eventos."
>
  <section class="page-head">
    <div class="container">
      <span class="head-eyebrow">Sección 02</span>
      <h1 class="display head-title">
        Publicaciones<span class="hero-dot">.</span>
      </h1>
      <p class="head-desc">
        Artículos publicados en revistas cubanas e internacionales y ponencias
        en eventos científicos. Consulta también mis perfiles académicos.
      </p>

      <div class="perfiles-inline">
        <a href={perfil.orcidUrl} class="perfil-chip perfil-chip-orcid" target="_blank" rel="noopener noreferrer">
          <span class="chip-label">ORCID</span>
          <span class="chip-value">{perfil.orcid}</span>
          <Icon name="external-link" size={14} stroke={2} />
        </a>
        <a href={perfil.scholarUrl} class="perfil-chip perfil-chip-scholar" target="_blank" rel="noopener noreferrer">
          <span class="chip-label">Google Académico</span>
          <span class="chip-value">Perfil de citas</span>
          <Icon name="external-link" size={14} stroke={2} />
        </a>
      </div>
    </div>
  </section>

  <section class="pubs-section">
    <div class="container">
      <ol class="pubs">
        {years.map((year) => (
          <li class="year-block">
            <div class="year-label" aria-hidden="true">
              <span>{year}</span>
            </div>
            <ul class="year-pubs">
              {porYear[year].map((p) => (
                <li class="pub-card">
                  <div class="pub-head">
                    <span class={`pub-rol pub-rol-${p.rol === 'Autor principal' ? 'principal' : 'coautor'}`}>
                      {p.rol}
                    </span>
                    <span class="pub-revista">{p.revista}</span>
                  </div>
                  <h3 class="pub-titulo display">{p.titulo}</h3>
                  <a
                    href={p.url}
                    class="pub-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Ver en revista <Icon name="external-link" size={14} stroke={2} />
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Descargar CV" />
</MicrositeLayout>

<style>
  .page-head { padding: var(--space-7) 0 var(--space-5); }
  .head-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-3);
  }
  .head-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 var(--space-3);
    color: var(--surface-dark);
  }
  .hero-dot { color: var(--micro-acento-suave); }
  .head-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 0 var(--space-5);
  }

  .perfiles-inline {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .perfil-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .perfil-chip:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .perfil-chip-orcid { background: #A6CE39; color: #1e2a38; }
  .perfil-chip-scholar { background: var(--micro-acento); color: var(--text-inverse); }
  .chip-label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .chip-value {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .pubs-section { padding: var(--space-5) 0 var(--space-8); }
  .pubs { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-6); }

  .year-block {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: var(--space-5);
    align-items: start;
  }
  .year-label {
    position: sticky;
    top: 90px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 4px;
  }
  .year-label span {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--micro-acento-suave);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .year-pubs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pub-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--micro-acento);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .pub-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }
  .pub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .pub-rol {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .pub-rol-principal {
    background: var(--micro-acento);
    color: var(--text-inverse);
  }
  .pub-rol-coautor {
    background: rgba(107, 39, 55, 0.08);
    color: var(--micro-acento);
  }
  .pub-revista {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-style: italic;
    text-align: right;
    flex-grow: 1;
  }
  .pub-titulo {
    font-size: 1.15rem;
    margin: 0;
    color: var(--surface-dark);
    line-height: 1.35;
  }
  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--micro-acento);
    align-self: flex-start;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: color var(--transition-fast);
  }
  .pub-link:hover { color: var(--micro-acento-suave); }

  @media (max-width: 900px) {
    .year-block { grid-template-columns: 1fr; gap: var(--space-3); }
    .year-label { position: static; justify-content: flex-start; }
    .year-label span { font-size: 1.6rem; }
    .pub-head { flex-direction: column; align-items: flex-start; gap: 6px; }
    .pub-revista { text-align: left; }
  }
</style>