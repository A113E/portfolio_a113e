---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import Icon from '../../components/Icon.astro';
import { perfil, formacion, certificaciones } from '../../data/investigador';

const navLinks = [
  { href: '/investigador', label: 'Portada' },
  { href: '/investigador/trayectoria', label: 'Trayectoria' },
  { href: '/investigador/publicaciones', label: 'Publicaciones' },
  { href: '/investigador/proyectos', label: 'Proyectos' },
  { href: '/investigador/formacion', label: 'Formación' },
];
---

<MicrositeLayout
  nombre="Investigador"
  acento="#6B2737"
  acentoSuave="#B8860B"
  navLinks={navLinks}
  title="Formación — Alberto M. · Investigación"
  description="Títulos oficiales y certificaciones que respaldan la labor investigativa."
>
  <section class="page-head">
    <div class="container">
      <span class="head-eyebrow">Sección 05</span>
      <h1 class="display head-title">
        Formación<span class="hero-dot">.</span>
      </h1>
      <p class="head-desc">
        Títulos oficiales y certificaciones que respaldan la labor investigativa.
      </p>
    </div>
  </section>

  <section class="formacion-section">
    <div class="container">
      <header class="block-head">
        <span class="block-eyebrow">Formación reglada</span>
        <h2 class="display block-title">
          Títulos oficiales<span class="hero-dot">.</span>
        </h2>
      </header>
      <div class="titulos-grid">
        {formacion.map((t) => (
          <article class={`titulo-card ${t.destacado ? 'titulo-card-featured' : ''}`}>
            <div class="titulo-ribbon"><span>{t.rango}</span></div>
            {t.destacado && (
              <div class="titulo-sello">
                <Icon name="award" size={16} stroke={2} />
                <span>{t.destacado}</span>
              </div>
            )}
            <h3 class="titulo-name display">{t.titulo}</h3>
            <p class="titulo-inst">{t.institucion}</p>
            <span class="titulo-periodo">{t.periodo}</span>
            {t.menciones.length > 0 && (
              <ul class="titulo-menciones">
                {t.menciones.map((m) => <li>{m}</li>)}
              </ul>
            )}
          </article>
        ))}
      </div>

      <header class="block-head block-head-spaced">
        <span class="block-eyebrow">Formación continua</span>
        <h2 class="display block-title">
          Certificaciones<span class="hero-dot">.</span>
        </h2>
      </header>
      <div class="certs-grid">
        {certificaciones.map((c) => (
          <article class="cert-card">
            <h3 class="cert-name display">{c.titulo}</h3>
            <p class="cert-inst">{c.institucion} · {c.periodo}</p>
            <p class="cert-desc">{c.descripcion}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Descargar CV" />
</MicrositeLayout>

<style>
  .page-head { padding: var(--space-7) 0 var(--space-5); }
  .head-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-3);
  }
  .head-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 var(--space-3);
    color: var(--surface-dark);
  }
  .hero-dot { color: var(--micro-acento-suave); }
  .head-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0;
  }
  .formacion-section { padding: var(--space-5) 0 var(--space-8); }
  .block-head { max-width: 620px; margin-bottom: var(--space-5); }
  .block-head-spaced { margin-top: var(--space-7); }
  .block-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-2);
  }
  .block-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin: 0;
    color: var(--surface-dark);
  }
  .titulos-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-4); }
  .titulo-card {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .titulo-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
  .titulo-ribbon {
    position: absolute;
    top: 0;
    left: var(--space-5);
    padding: 8px 14px;
    background: var(--micro-acento);
    color: var(--text-inverse);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }
  .titulo-ribbon span {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .titulo-sello {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: linear-gradient(135deg, rgba(184, 134, 11, 0.15), rgba(184, 134, 11, 0.05));
    border: 1px solid var(--micro-acento-suave);
    color: var(--micro-acento-suave);
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: var(--space-4);
  }
  .titulo-card-featured {
    background: linear-gradient(180deg, var(--bg-elevated), rgba(184, 134, 11, 0.03));
    border-color: rgba(184, 134, 11, 0.3);
  }
  .titulo-name { font-size: 1.5rem; margin: 0; color: var(--surface-dark); line-height: 1.2; }
  .titulo-inst { font-size: 0.95rem; color: var(--micro-acento); font-weight: 600; margin: 0; }
  .titulo-periodo { font-size: 0.85rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .titulo-menciones {
    list-style: none;
    padding: var(--space-3) 0 0;
    margin: var(--space-3) 0 0;
    border-top: 1px dashed var(--border);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .titulo-menciones li {
    font-size: 0.88rem;
    color: var(--text-muted);
    padding-left: 14px;
    position: relative;
  }
  .titulo-menciones li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--micro-acento-suave);
    font-weight: 700;
  }
  .certs-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4); }
  .cert-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .cert-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .cert-name { font-size: 1.15rem; margin: 0 0 4px; color: var(--surface-dark); }
  .cert-inst { font-size: 0.88rem; color: var(--micro-acento); font-weight: 600; margin: 0 0 var(--space-3); }
  .cert-desc { font-size: 0.92rem; color: var(--text-muted); margin: 0; line-height: 1.55; }

  @media (max-width: 900px) {
    .titulos-grid { grid-template-columns: 1fr; }
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>