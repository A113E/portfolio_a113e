---
import MicrositeLayout from '../../layouts/MicrositeLayout.astro';
import FloatingCV from '../../components/FloatingCV.astro';
import Icon from '../../components/Icon.astro';
import { perfil, publicaciones, proyectos, eventos, trayectoria } from '../../data/investigador';

const navLinks = [
  { href: '/investigador', label: 'Portada' },
  { href: '/investigador/trayectoria', label: 'Trayectoria' },
  { href: '/investigador/publicaciones', label: 'Publicaciones' },
  { href: '/investigador/proyectos', label: 'Proyectos' },
  { href: '/investigador/formacion', label: 'Formación' },
];

const subsecciones = [
  { numero: '01', href: '/investigador/trayectoria', titulo: 'Trayectoria', descripcion: 'Labor investigativa, asesoría metodológica y apoyo a la producción científica.', icono: 'compass' },
  { numero: '02', href: '/investigador/publicaciones', titulo: 'Publicaciones', descripcion: 'Artículos en revistas cubanas e internacionales y ponencias en eventos.', icono: 'file-text' },
  { numero: '03', href: '/investigador/proyectos', titulo: 'Proyectos', descripcion: 'Proyectos I+D en salud, educación e informática en los que he participado.', icono: 'flask' },
  { numero: '04', href: '/investigador/eventos', titulo: 'Eventos', descripcion: 'Congresos, simposios y jornadas científicas.', icono: 'mic' },
  { numero: '05', href: '/investigador/formacion', titulo: 'Formación', descripcion: 'Títulos y certificaciones académicas.', icono: 'award' },
];

const stats = [
  { valor: publicaciones.length, label: 'publicaciones' },
  { valor: proyectos.length, label: 'proyectos' },
  { valor: eventos.length, label: 'eventos científicos' },
  { valor: trayectoria.length, label: 'institución investigativa' },
];
---

<MicrositeLayout
  nombre="Investigador"
  acento="#6B2737"
  acentoSuave="#B8860B"
  navLinks={navLinks}
  title="Investigación — Alberto Adrián Mártir González"
  description="Investigador técnico en Ciencias de la Información. Publicaciones, proyectos I+D, eventos científicos y asesoría metodológica."
>
  <!-- HERO -->
<section class="hero">
  <div class="container hero-grid">
    <!-- Columna izquierda: contenido -->
    <div class="hero-content">
      <span class="hero-kicker">Investigador técnico</span>
      <h1 class="display hero-title">
        Producción<span class="hero-dot">.</span><br />
        Rigor<span class="hero-dot">.</span><br />
        Colaboración<span class="hero-dot">.</span>
      </h1>
      <p class="hero-titular">{perfil.titular}</p>
      <p class="hero-resumen">{perfil.resumen}</p>

      <div class="hero-actions">
        <a href={perfil.orcidUrl} class="btn-orcid" target="_blank" rel="noopener noreferrer">
          <Icon name="external-link" size={16} stroke={2} />
          ORCID
        </a>
        <a href={perfil.scholarUrl} class="btn-scholar" target="_blank" rel="noopener noreferrer">
          <Icon name="external-link" size={16} stroke={2} />
          Google Académico
        </a>
        <a href={perfil.cv} class="btn-ghost-hero">Ver CV →</a>
      </div>

      <ul class="hero-stats">
        {stats.map((s) => (
          <li>
            <strong>{s.valor}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Columna derecha: foto -->
    <div class="hero-photo">
      <div class="photo-frame">
        <img src="/img/albe_2.png" alt="Retrato de Alberto Adrián Mártir González" />
      </div>
      <div class="photo-accent" aria-hidden="true"></div>
    </div>
  </div>
</section>

  <!-- SUBSECCIONES -->
  <section class="subsecciones">
    <div class="container">
      <header class="sub-head">
        <span class="sub-eyebrow">Explora</span>
        <h2 class="display sub-title">
          Cinco dimensiones de la investigación<span class="hero-dot">.</span>
        </h2>
      </header>

      <div class="tabs">
        {subsecciones.map((s) => (
          <a href={s.href} class="tab">
            <div class="tab-top">
              <span class="tab-icon">
                <Icon name={s.icono} size={24} stroke={1.7} />
              </span>
              <span class="tab-num">{s.numero}</span>
            </div>
            <h3 class="tab-title display">{s.titulo}</h3>
            <p class="tab-desc">{s.descripcion}</p>
            <span class="tab-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PERFILES ACADÉMICOS -->
  <section class="perfiles-section">
    <div class="container">
      <header class="sub-head">
        <span class="sub-eyebrow">Perfiles académicos</span>
        <h2 class="display sub-title">
          Encuéntrame en<span class="hero-dot">.</span>
        </h2>
        <p class="sub-desc">
          Consulta mis publicaciones, citas y redes académicas en los perfiles oficiales.
        </p>
      </header>

      <div class="perfiles-grid">
        <a href={perfil.orcidUrl} class="perfil-card perfil-orcid" target="_blank" rel="noopener noreferrer">
          <span class="perfil-label">ORCID</span>
          <span class="perfil-value">{perfil.orcid}</span>
          <span class="perfil-cta">Ver perfil <Icon name="external-link" size={14} stroke={2} /></span>
        </a>
        <a href={perfil.scholarUrl} class="perfil-card perfil-scholar" target="_blank" rel="noopener noreferrer">
          <span class="perfil-label">Google Académico</span>
          <span class="perfil-value">Perfil de citas</span>
          <span class="perfil-cta">Ver perfil <Icon name="external-link" size={14} stroke={2} /></span>
        </a>
      </div>
    </div>
  </section>

  <FloatingCV href={perfil.cv} label="Ver CV" />
</MicrositeLayout>

<style>
  /* ---------- HERO ---------- */
.hero {
  padding: var(--space-8) 0 var(--space-6);
  background: linear-gradient(180deg, rgba(107, 39, 55, 0.04), transparent);
  border-bottom: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: var(--space-7);
  align-items: center;
}

.hero-content {
  min-width: 0;
}

.hero-kicker {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--micro-acento-suave);
  margin-bottom: var(--space-4);
}

.hero-title {
  font-size: clamp(2.5rem, 5.5vw, 4.5rem);
  margin: 0 0 var(--space-4);
  color: var(--surface-dark);
  line-height: 1.05;
}

.hero-dot { color: var(--micro-acento-suave); }

.hero-titular {
  font-size: 1.05rem;
  color: var(--micro-acento);
  font-weight: 600;
  margin: 0 0 var(--space-4);
}

.hero-resumen {
  font-size: 1.02rem;
  color: var(--text-muted);
  margin: 0 0 var(--space-5);
  max-width: 640px;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  gap: var(--space-3);
  flex-wrap: wrap;
  margin-bottom: var(--space-6);
}

.btn-orcid,
.btn-scholar,
.btn-ghost-hero {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: var(--radius-pill);
  font-weight: 600;
  font-size: 0.9rem;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-orcid {
  background: #A6CE39;
  color: #1e2a38;
}
.btn-orcid:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

.btn-scholar {
  background: var(--micro-acento);
  color: var(--text-inverse);
}
.btn-scholar:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

.btn-ghost-hero {
  background: transparent;
  color: var(--surface-dark);
  border: 1px solid var(--border);
}
.btn-ghost-hero:hover { border-color: var(--surface-dark); transform: translateY(-2px); }

.hero-stats {
  list-style: none;
  padding: var(--space-4) 0 0;
  margin: 0;
  border-top: 1px solid var(--border);
  display: flex;
  gap: var(--space-6);
  flex-wrap: wrap;
}
.hero-stats li {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.hero-stats strong {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 600;
  color: var(--micro-acento);
  line-height: 1;
}
.hero-stats span {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* Foto del hero */
.hero-photo {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.photo-frame {
  width: 100%;
  max-width: 340px;
  aspect-ratio: 3 / 4;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: linear-gradient(180deg, #fff, #efece5);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 1;
}

.photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  display: block;
}

.photo-accent {
  position: absolute;
  inset: auto -20px -20px auto;
  width: 130px;
  height: 130px;
  border: 2px solid var(--micro-acento-suave);
  border-radius: 50%;
  z-index: 0;
  opacity: 0.5;
}

/* Responsive */
@media (max-width: 900px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: var(--space-6);
    text-align: center;
  }
  .hero-content {
    order: 2;
  }
  .hero-photo {
    order: 1;
  }
  .hero-title {
    font-size: clamp(2.2rem, 8vw, 3.2rem);
  }
  .hero-titular,
  .hero-resumen {
    margin-left: auto;
    margin-right: auto;
  }
  .hero-actions {
    justify-content: center;
  }
  .hero-stats {
    justify-content: center;
    gap: var(--space-4);
  }
  .photo-frame {
    max-width: 240px;
  }
  .photo-accent {
    display: none;
  }
}

  .subsecciones { padding: var(--space-7) 0; }
  .sub-head { max-width: 720px; margin-bottom: var(--space-5); }
  .sub-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--micro-acento-suave);
    margin-bottom: var(--space-2);
  }
  .sub-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 var(--space-2);
    color: var(--surface-dark);
  }
  .sub-desc { color: var(--text-muted); margin: 0; }

  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .tab {
    position: relative;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-5) var(--space-4) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .tab::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 3px;
    background: var(--micro-acento);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .tab:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }
  .tab:hover::before { transform: scaleX(1); }
  .tab-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .tab-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(107, 39, 55, 0.08);
    color: var(--micro-acento);
  }
  .tab-num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--micro-acento-suave);
  }
  .tab-title {
    font-size: 1.35rem;
    margin: 0;
    color: var(--surface-dark);
  }
  .tab-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0;
    flex-grow: 1;
  }
  .tab-arrow {
    font-size: 1.2rem;
    color: var(--text-muted);
    transition: transform var(--transition-base), color var(--transition-base);
  }
  .tab:hover .tab-arrow {
    transform: translateX(6px);
    color: var(--micro-acento);
  }

  .perfiles-section {
    padding: var(--space-7) 0 var(--space-8);
    background: rgba(107, 39, 55, 0.03);
    border-top: 1px solid var(--border);
  }
  .perfiles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    max-width: 720px;
  }
  .perfil-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-5);
    border-radius: var(--radius);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .perfil-orcid {
    background: #A6CE39;
    color: #1e2a38;
  }
  .perfil-scholar {
    background: var(--micro-acento);
    color: var(--text-inverse);
  }
  .perfil-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .perfil-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .perfil-value {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
  }
  .perfil-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    margin-top: var(--space-2);
    opacity: 0.9;
  }

  @media (max-width: 900px) {
    .tabs { grid-template-columns: 1fr; }
    .perfiles-grid { grid-template-columns: 1fr; }
    .hero-stats { gap: var(--space-4); }
  }
</style>