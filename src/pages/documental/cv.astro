---
import CVLayout from '../../layouts/CVLayout.astro';
import Icon from '../../components/Icon.astro';
import {
  perfil,
  trayectoria,
  habilidades,
  titulosOficiales,
  certificaciones,
  formacionComplementaria,
  softSkills,
  idiomas,
} from '../../data/documental';

const habilidadesPlanas = habilidades.categorias.map((cat) => ({
  categoria: cat.titulo,
  items: cat.items.map((i) => i.nombre),
}));

const contacto = [
  { icono: 'email', valor: perfil.email },
  { icono: 'telefono', valor: '+53 5 8426686' },
  { icono: 'ubicacion', valor: perfil.ubicacion },
  { icono: 'linkedin', valor: 'linkedin.com/in/alberto-gonzalez-9b4777339' },
  { icono: 'github', valor: 'github.com/A113E' },
];
---

<CVLayout title="CV — Alberto Adrián Mártir González · Gestión Documental">
  <!-- ============ CABECERA ============ -->
  <header class="cv-header">
    <div class="cv-photo">
      <img src="/img/albe_carnet.png" alt="Foto de perfil de Alberto M." />
    </div>
    <div class="cv-header-main">
      <h1 class="cv-name">{perfil.nombre}</h1>
      <p class="cv-title">{perfil.titular}</p>
    </div>
    <ul class="cv-contact">
      {contacto.map((c) => (
        <li>
          <Icon name={c.icono} size={14} stroke={1.8} />
          <span>{c.valor}</span>
        </li>
      ))}
    </ul>
  </header>

  <!-- ============ PERFIL ============ -->
  <section class="cv-section">
    <h2 class="cv-section-title">Perfil profesional</h2>
    <p class="cv-summary">{perfil.resumen}</p>
  </section>

  <!-- ============ EXPERIENCIA ============ -->
  <section class="cv-section">
    <h2 class="cv-section-title">Experiencia profesional</h2>
    {trayectoria.map((t) => (
      <article class="cv-job">
        <header class="cv-job-head">
          <div>
            <h3 class="cv-job-cargo">{t.cargo}</h3>
            <p class="cv-job-inst">{t.institucion} · {t.ubicacion}</p>
          </div>
          <span class="cv-job-periodo">{t.periodo}</span>
        </header>
        <ul class="cv-job-funciones">
          {t.funciones.map((f) => <li>{f}</li>)}
        </ul>
        {t.logros.length > 0 && (
          <ul class="cv-job-logros">
            {t.logros.map((l) => <li>{l}</li>)}
          </ul>
        )}
      </article>
    ))}
  </section>

  <!-- ============ HABILIDADES ============ -->
  <section class="cv-section">
    <h2 class="cv-section-title">Habilidades técnicas</h2>
    <div class="cv-skills-grid">
      {habilidadesPlanas.map((h) => (
        <div class="cv-skill-group">
          <h3 class="cv-skill-cat">{h.categoria}</h3>
          <p class="cv-skill-list">{h.items.join(' · ')}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ FORMACIÓN ============ -->
  <section class="cv-section">
    <h2 class="cv-section-title">Formación</h2>
    <div class="cv-edu-block">
      {titulosOficiales.map((t) => (
        <article class="cv-edu">
          <header class="cv-edu-head">
            <div>
              <h3 class="cv-edu-titulo">{t.titulo}</h3>
              <p class="cv-edu-inst">{t.institucion} · {t.ubicacion}</p>
            </div>
            <span class="cv-edu-periodo">{t.periodo}</span>
          </header>
          {t.destacado && <p class="cv-edu-destacado">{t.destacado}</p>}
        </article>
      ))}
    </div>
    <div class="cv-cert-block">
      <h3 class="cv-subtitle">Certificaciones y formación continua</h3>
      <ul class="cv-cert-list">
        {certificaciones.map((c) => (
          <li>
            <strong>{c.titulo}</strong> — {c.institucion} ({c.periodo})
          </li>
        ))}
        <li>
          <strong>Formación complementaria:</strong> {formacionComplementaria.join(' · ')}
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ IDIOMAS Y SOFT SKILLS ============ -->
  <section class="cv-section cv-section-final">
    <div class="cv-two-col">
      <div>
        <h2 class="cv-section-title">Idiomas</h2>
        <ul class="cv-idiomas">
          {idiomas.map((i) => (
            <li><strong>{i.nombre}</strong> — {i.nivel} ({i.etiqueta})</li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="cv-section-title">Soft skills</h2>
        <p class="cv-soft">{softSkills.map((s) => s.nombre).join(' · ')}</p>
      </div>
    </div>
  </section>
</CVLayout>