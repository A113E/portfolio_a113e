  ubicacion: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  linkedin: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.13 1.44-2.13 2.94v5.66H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>`,
  orcid: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zM7.15 17.71H5.39V8.51h1.76v9.2zM6.27 7.72a1.03 1.03 0 1 1 0-2.06 1.03 1.03 0 0 1 0 2.06zm11.58 9.99h-1.76v-4.74c0-1.13-.02-2.58-1.57-2.58-1.57 0-1.81 1.23-1.81 2.5v4.82h-1.76V8.51h1.69v1.26h.02c.24-.45.81-.92 1.67-.92 1.79 0 2.12 1.18 2.12 2.71v6.15z"/></svg>`,
  scholar: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2 0 8l12 6 9-4.5V17h2V8L12 2zM4.7 12.6v3.9c0 .1.1.2.2.3 2.9 1.3 7.3 1.3 10.2 0 .1-.1.2-.2.2-.3v-3.9L12 15.3l-7.3-2.7z"/></svg>`,
  github: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.3-3.2-.1-.3-.6-1.6.1-3.3 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.2 3 .1 3.3.8.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z"/></svg>`,
  x: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.81-5.96 6.81H1.69l7.73-8.84L1.25 2.25h6.82l4.71 6.23 5.46-6.23zm-1.16 17.52h1.83L7.02 4.13H5.06l12.02 15.64z"/></svg>`,
};
---

<BaseLayout
  title="Contacto — Alberto Adrián Mártir González"
  description="Canales de contacto profesional de Alberto Adrián Mártir González: email, teléfono, LinkedIn, ORCID, GitHub y redes sociales."
>
  <Nav />

  <!-- ============ HERO ============ -->
  <section class="contact-hero">
    <div class="container">
      <span class="eyebrow">Contacto</span>
      <h1 class="display contact-title">
        Hablemos<span class="dot">.</span>
      </h1>
      <p class="contact-sub">
        Abierto a colaboraciones, proyectos, consultorías y oportunidades
        profesionales. Elige el canal que prefieras —respondo en menos de 24 h
        cuando es posible.
      </p>
    </div>
  </section>

  <!-- ============ CANALES PRINCIPALES ============ -->
  <section class="contact-main">
    <div class="container">
      <ul class="principales-grid">
        {principales.map((c) => (
          <li class="principal-card">
            <span class="principal-icon" set:html={iconos[c.tipo]} />
            <div class="principal-body">
              <span class="principal-label">{c.label}</span>
              {c.href ? (
                <a
                  href={c.href}
                  class="principal-value"
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {c.value}
                </a>
              ) : (
                <span class="principal-value">{c.value}</span>
              )}
            </div>
            {c.copy && (
              <button
                type="button"
                class="copy-btn"
                data-copy-email={c.value}
                aria-label={`Copiar ${c.label}`}
              >
                <span class="copy-label">Copiar</span>
              </button>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ REDES PROFESIONALES ============ -->
  <section class="contact-redes">
    <div class="container">
      <h2 class="redes-title display">
        Perfiles profesionales<span class="dot">.</span>
      </h2>
      <ul class="redes-grid">
        {profesionales.map((r) => (
          <li>
            <a
              href={r.href}
              class="red-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="red-icon" set:html={iconos[r.tipo]} />
              <div class="red-body">
                <span class="red-label">{r.label}</span>
                <span class="red-value">{r.value}</span>
              </div>
              <span class="red-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ REDES SOCIALES ============ -->
  <section class="contact-social">
    <div class="container">
      <h2 class="redes-title display">
        Redes sociales<span class="dot">.</span>
      </h2>
      <ul class="social-grid">
        {sociales.map((r) => (
          <li>
            <a
              href={r.href}
              class="social-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="red-icon" set:html={iconos[r.tipo]} />
              <div class="red-body">
                <span class="red-label">{r.label}</span>
                <span class="red-value">{r.value}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/copy-email.js';
</script>

<style>
  /* ---------- HERO ---------- */
  .contact-hero {
    padding: var(--space-8) 0 var(--space-5);
  }
  .contact-title {
    font-size: clamp(3rem, 7vw, 5rem);
    margin: var(--space-3) 0 var(--space-4);
    color: var(--surface-dark);
  }
  .contact-sub {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 620px;
    margin: 0;
  }

  /* ---------- CANALES PRINCIPALES ---------- */
  .contact-main { padding: var(--space-5) 0 var(--space-6); }
  .principales-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .principal-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .principal-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .principal-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--surface-dark);
    color: var(--accent);
    flex-shrink: 0;
  }
  .principal-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
    min-width: 0;
  }
  .principal-label {
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .principal-value {
    font-size: 0.98rem;
    font-weight: 500;
    color: var(--surface-dark);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  a.principal-value {
    transition: color var(--transition-fast);
  }
  a.principal-value:hover {
    color: var(--accent);
  }

  .copy-btn {
    flex-shrink: 0;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: all var(--transition-fast);
  }
  .copy-btn:hover {
    border-color: var(--surface-dark);
    color: var(--surface-dark);
  }
  .copy-btn.is-copied {
    background: var(--accent);
    color: var(--surface-dark);
    border-color: var(--accent);
  }
  .copy-btn.is-error {
    background: #f8d7da;
    color: #842029;
    border-color: #f5c2c7;
  }

  /* ---------- REDES PROFESIONALES Y SOCIALES ---------- */
  .contact-redes,
  .contact-social {
    padding: var(--space-6) 0;
  }
  .contact-social { padding-bottom: var(--space-8); }

  .redes-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 var(--space-4);
    color: var(--surface-dark);
  }

  .redes-grid,
  .social-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .redes-grid { grid-template-columns: repeat(3, 1fr); }
  .social-grid { grid-template-columns: repeat(3, 1fr); }

  .red-card,
  .social-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  }
  .red-card:hover,
  .social-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }

  .red-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--surface-dark);
    flex-shrink: 0;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .red-card:hover .red-icon,
  .social-card:hover .red-icon {
    background: var(--accent);
    color: var(--surface-dark);
  }

  .red-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-grow: 1;
    min-width: 0;
  }
  .red-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--surface-dark);
  }
  .red-value {
    font-size: 0.82rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .red-arrow {
    font-size: 1.1rem;
    color: var(--text-muted);
    transition: transform var(--transition-base), color var(--transition-base);
    flex-shrink: 0;
  }
  .red-card:hover .red-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 900px) {
    .principales-grid { grid-template-columns: 1fr; }
    .redes-grid { grid-template-columns: 1fr; }
    .social-grid { grid-template-columns: 1fr; }
  }
</style>