const ubicacion = 'Cerro, La Habana, Cuba';

const principales = [
  {
    tipo: 'email',
    label: 'Email',
    value: email,
    href: `mailto:${email}`,
    copy: true,
  },
  {
    tipo: 'telefono',
    label: 'Teléfono',
    value: telefono,
    href: telefonoHref,
  },
  {
    tipo: 'ubicacion',
    label: 'Ubicación',
    value: ubicacion,
    href: null,
  },
  {
    tipo: 'linkedin',
    label: 'LinkedIn',
    value: 'cu.linkedin.com/in/alberto-gonzalez-9b4777339',
    href: 'https://cu.linkedin.com/in/alberto-gonzalez-9b4777339',
  },
];

const profesionales = [
  {
    tipo: 'orcid',
    label: 'ORCID',
    value: '0009-0006-0403-9422',
    href: 'https://orcid.org/0009-0006-0403-9422',
  },
  {
    tipo: 'scholar',
    label: 'Google Académico',
    value: 'Perfil de citas',
    href: 'https://scholar.google.com/citations?user=jbtpyo4AAAAJ&hl=es',
  },
  {
    tipo: 'github',
    label: 'GitHub',
    value: 'github.com/A113E',
    href: 'https://github.com/A113E',
  },
];

const sociales = [
  {
    tipo: 'instagram',
    label: 'Instagram',
    value: '@a113e',
    href: 'https://www.instagram.com/a113e',
  },
  {
    tipo: 'facebook',
    label: 'Facebook',
    value: 'Alberto Mártir',
    href: 'https://www.facebook.com/share/19oJrihWYC/',
  },
  {
    tipo: 'x',
    label: 'X',
    value: '@Alberto95691445',
    href: 'https://x.com/Alberto95691445',
  },
];

const iconos = {
  email: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>`,
