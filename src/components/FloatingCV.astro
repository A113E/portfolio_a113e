---
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Descargar CV' } = Astro.props;
const isFile = /\.(pdf|docx?|odt)$/i.test(href);
---

<a href={href} class="floating-cv"  download={isFile ? '' : undefined}>
  <span class="floating-cv-icon" aria-hidden="true">↓</span>
  <span class="floating-cv-text">{label}</span>
</a>

<style>
  .floating-cv {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 12px 20px;
    background: var(--surface-dark);
    color: var(--text-inverse);
    border-radius: var(--radius-pill);
    font-size: 0.88rem;
    font-weight: 600;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base), background var(--transition-base);
  }
  .floating-cv:hover {
    transform: translateY(-3px);
    background: var(--surface-dark-2);
  }
  .floating-cv-icon {
    font-size: 1.05rem;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .floating-cv {
      right: var(--space-3);
      bottom: var(--space-3);
      padding: 10px 16px;
    }
    .floating-cv-text {
      display: none;
    }
    .floating-cv-icon {
      font-size: 1.3rem;
    }
  }
</style>